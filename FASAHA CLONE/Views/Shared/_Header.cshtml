@{
}
<div class="header-container" style="background-color: #c92127; padding: 10px 20px; display: flex; align-items: center; justify-content: space-between; gap: 15px;">

    <!-- Icon Menu / Danh mục -->
    <div class="header-icon-menu">
        <a href="https://www.fahasa.com/?srsltid=AU7gw4W52xPsCyo-buHi4bGn6KfrQzGowgeBfvJTNc-nQKFO6rdKN67y" class="fhs-icon-menu">
            <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanity/default/images/ico_menu.svg" alt="Danh Mục Sản Phẩm" width="24" height="24">
        </a>
    </div>

    <!-- Logo Fahasa -->
    <div class="header-logo">
        <a href="https://www.fahasa.com/?srsltid=AU7gw4W52xPsCyo-buHi4bGn6KfrQzGowgeBfvJTNc-nQKFO6rdKN67y" title="FAHASA.COM" class="logo">
            <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanity/default/images/fahasa-logo.png" alt="FAHASA.COM" style="max-height: 40px;">
        </a>
    </div>

    <!-- Thanh tìm kiếm -->
    <div class="header-search-bar" style="flex: 1; max-width: 650px;">
        <form id="search_mini_form" action="https://www.fahasa.com/catalogsearch/result/" method="get">
            <div class="input-box" style="display: flex; background: #fff; border-radius: 8px; padding: 2px 8px;">
                <input id="search" type="text" name="q" value="" class="input-text" placeholder="50 năm Fahasa..." style="width: 100%; border: none; outline: none; padding: 8px;" />
                <button type="submit" title="Tìm kiếm" class="button-search" style="background: transparent; border: none; cursor: pointer; padding: 8px;">
                    <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanity/default/images/ico_search.svg" alt="Search" width="18" height="18">
                </button>
            </div>
        </form>
    </div>

    <!-- Giỏ hàng & Tài khoản -->
    <div class="header-actions" style="display: flex; align-items: center; gap: 15px;">
        <!-- Cart -->
        <a href="https://www.fahasa.com/checkout/cart/" class="header-cart-icon" title="Giỏ hàng">
            <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanity/default/images/ico_cart.svg" alt="Giỏ hàng" width="26" height="26">
        </a>
        <!-- Account -->
        <a href="https://www.fahasa.com/customer/account/login/" class="header-account-icon" title="Tài khoản">
            <img src="https://cdn0.fahasa.com/skin/frontend/ma_vanity/default/images/ico_account.svg" alt="Tài khoản" width="26" height="26">
        </a>
    </div>

</div>