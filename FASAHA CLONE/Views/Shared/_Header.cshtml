@{
}
<!-- HEADER FAHASA -->
<div class="header-container" style="background-color: #ff6fa4; padding: 10px 20px; display: flex; align-items: center; justify-content: space-between; gap: 15px;">

    <!-- Icon Menu / Danh mục -->
    <div class="header-icon-menu">
        <a href="/Product" class="btn" title="Danh mục sách">
            <i class="bi bi-grid" style="font-size: 24px; color: #fff;"></i>
        </a>
    </div>

    <!-- Logo Fahasa -->
    <div class="header-logo">
        <a href="/" title="MIAOO.COM" class="logo">
            <img src="~/images/logo-icon.png" alt="MIAOO.COM" style="max-height: 80px;">
        </a>
    </div>

    <!-- Thanh tìm kiếm -->
    <div class="header-search-bar" style="flex: 1; max-width: 650px;">
        <form id="search_mini_form" action="/Product" method="get">
            <div class="input-box" style="display: flex; background: #fff; border-radius: 8px; padding: 2px 8px;">
                <input id="search" type="text" name="keyword" value="" class="input-text" placeholder="Thử tìm kiếm..." style="width: 100%; border: none; outline: none; padding: 8px;" />
                <button type="submit" title="Tìm kiếm" class="button-search" style="background: transparent; border: none; cursor: pointer; padding: 8px;">
                    <i class="bi bi-search-heart-fill" style="font-size: 18px; color: #ff6fa4;"></i>
                </button>
            </div>
        </form>
    </div>

    <!-- Giỏ hàng & Tài khoản -->
    <div class="header-actions" style="display: flex; align-items: center; gap: 15px;">
        <!-- Cart -->
        <a href="/Cart" class="header-cart-icon" title="Giỏ hàng">
            <i class="bi bi-cart2" style="font-size: 26px; color: #fff;"></i>
        </a>
        <!-- Account -->
        <a href="/Account/Login" title="Tài khoản" class="header-account-icon" ">
            <i class="bi bi-person" style="font-size: 26px; color: #fff;"></i>
        </a>
        <a href="/Order/History" class="text-decoration-none" title="Lịch sử mua hàng">
            <i class=" bi bi-receipt"" style="font-size: 26px; color: #fff;"></i>
        </a>
    </div>

</div>
